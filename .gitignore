# ==========================================================================
# Nightmare Cleaner — Unity .gitignore
# 자동 생성 / 로컬 전용 폴더는 커밋하지 않는다(각자 컴퓨터에서 다시 생성됨).
# Assets/, Packages/, ProjectSettings/ 와 모든 .meta 파일은 반드시 커밋된다.
# ==========================================================================

# ---- Unity 자동 생성 (커밋 금지) ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 에셋 메타 파일은 대응 에셋과 함께 반드시 커밋 (아래 규칙으로 무시 방지)
!/[Aa]ssets/**/*.meta

# ---- IDE / 빌드 도구 생성물 ----
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# ---- Unity 크래시 / 빌드 산출물 ----
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
UpgradeLog*.htm
UpgradeLog*.XML

# ---- Claude Code 로컬 도구 ----
.claude/

# ---- OS ----
.DS_Store
Thumbs.db
